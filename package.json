{
  "name": "itam-application",
  "version": "1.0.0",
  "description": "IT Asset Lifecycle Manager - SAP CAP Node.js",
  "type": "module",
  "dependencies": {
    "@cap-js/hana": "^3",
    "@sap/cds": "^10",
    "@sap/xssec": "^4.15.0"
  },
  "devDependencies": {
    "@cap-js/sqlite": "^3",
    "@sap/cds-dk": "^10"
  },
  "scripts": {
    "start": "cds-serve",
    "watch": "cds watch",
    "build:apps": "node scripts/copy-apps.js"
  },
  "cds": {
    "requires": {
      "db": "hana",
      "auth": "xsuaa",
      "mail": {
        "impl": "srv/mail-service.js"
      },
      "[hybrid]": {
        "db": "hana",
        "auth": {
          "kind": "mocked",
          "users": {
            "admin@itam-demo.com": {
              "password": "admin",
              "roles": [
                "Admin"
              ]
            },
            "manager@itam-demo.com": {
              "password": "manager",
              "roles": [
                "Manager"
              ]
            },
            "ravi.kumar@itam-demo.com": {
              "password": "user",
              "roles": [
                "User"
              ]
            }
          }
        }
      },
      "[development]": {
        "db": {
          "kind": "sqlite",
          "credentials": {
            "url": ":memory:"
          }
        },
        "auth": {
          "kind": "mocked",
          "users": {
            "admin@itam-demo.com": {
              "password": "admin",
              "roles": [
                "Admin"
              ]
            },
            "manager@itam-demo.com": {
              "password": "manager",
              "roles": [
                "Manager"
              ]
            },
            "ravi.kumar@itam-demo.com": {
              "password": "user",
              "roles": [
                "User"
              ]
            }
          }
        }
      }
    }
  },
  "engines": {
    "node": ">=22"
  }
}
